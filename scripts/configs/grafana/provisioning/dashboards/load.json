    {
      "type": "timeseries",
      "title": "Postgres pool: average wait per acquire",
      "description": "Rising wait means the pool (25 connections) is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
