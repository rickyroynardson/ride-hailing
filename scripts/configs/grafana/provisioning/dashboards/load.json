        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pgxpool_acquire_seconds_total[1m]) / clamp_min(rate(pgxpool_acquire_total[1m]), 1e-9)",
          "legendFormat": "{{job}}",
          "refId": "A"
